+
+@router.delete("/entities/{entity_id}/vendors/{vendor_id}", status_code=204)
+def delete_vendor(
+    entity_id: int,
+    vendor_id: int,
+    db: Session = Depends(get_db),
+    auth: AuthContext = Depends(require_entity_admin_scope),
+):
+    vendor = _get_vendor_or_404(db, entity_id, vendor_id)
+    in_use = db.query(Warehouse).filter(Warehouse.vendor_id == vendor_id).first()
+    if in_use:
+        raise ApiError(400, "VENDOR_IN_USE", "Cannot delete vendor because it is assigned to one or more warehouses.")
+    
+    db.delete(vendor)
+    db.commit()
